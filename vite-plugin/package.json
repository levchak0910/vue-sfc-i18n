{
  "name": "@vue-sfc-i18n/vite-plugin",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false --declaration true --outDir dist",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vue-sfc-i18n/generate": "workspace:*",
    "@vue-sfc-i18n/shared": "workspace:*",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
