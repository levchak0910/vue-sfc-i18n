{
  "name": "@vue-sfc-i18n/vite-plugin",
  "version": "0.0.4",
  "description": "Vite plugin for transforming Vue SFC i18n custom blocks at build time",
  "keywords": [
    "vue",
    "vue3",
    "i18n",
    "sfc",
    "vite",
    "vite-plugin",
    "internationalization"
  ],
  "author": "Sándor Levcsák",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n.git"
  },
  "homepage": "git+https://github.com/levchak0910/vue-sfc-i18n#readme",
  "bugs": {
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false --declaration true --outDir dist",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vue-sfc-i18n/generate": "workspace:*",
    "@vue-sfc-i18n/shared": "workspace:*",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
