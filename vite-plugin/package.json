{
  "name": "@vue-sfc-i18n/vite-plugin",
  "version": "0.0.8",
  "description": "Vite plugin for transforming Vue SFC i18n custom blocks at build time",
  "keywords": [
    "i18n",
    "internationalization",
    "sfc",
    "vite",
    "vite-plugin",
    "vue",
    "vue3"
  ],
  "homepage": "git+https://github.com/levchak0910/vue-sfc-i18n#readme",
  "bugs": {
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n/issues"
  },
  "license": "MIT",
  "author": "Sándor Levcsák",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --declaration true --outDir dist",
    "type-check": "tsc --noEmit",
    "install:deps": "playwright install --with-deps chromium",
    "spa:dev": "vite tests/fixtures/spa --port 5170",
    "spa:build": "vite build tests/fixtures/spa",
    "spa:prod": "pnpm spa:build && NODE_ENV=production vite preview tests/fixtures/spa --port 5171",
    "mpa:dev": "PORT=5180 node tests/fixtures/mpa/server/index.js",
    "mpa:build:client": "vite build tests/fixtures/mpa --outDir dist/client",
    "mpa:build:server": "vite build tests/fixtures/mpa --ssr src/entry-server.ts --outDir dist/server",
    "mpa:build": "pnpm mpa:build:client && pnpm mpa:build:server",
    "mpa:prod": "pnpm mpa:build && PORT=5181 NODE_ENV=production node tests/fixtures/mpa/server/index.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vue-sfc-i18n/generate": "workspace:*",
    "@vue-sfc-i18n/shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.41",
    "oxc-parser": "^0.147.0",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.2",
    "@types/picomatch": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue-sfc-i18n/composable": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.41"
  }
}
