{
  "name": "@vue-sfc-i18n/eslint-plugin",
  "version": "0.0.4",
  "description": "ESLint plugin for enforcing i18n conventions in Vue SFC custom blocks",
  "keywords": [
    "vue",
    "vue3",
    "i18n",
    "sfc",
    "eslint",
    "eslint-plugin",
    "internationalization"
  ],
  "author": "Sándor Levcsák",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n.git"
  },
  "homepage": "git+https://github.com/levchak0910/vue-sfc-i18n#readme",
  "bugs": {
    "url": "git+https://github.com/levchak0910/vue-sfc-i18n/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false --allowImportingTsExtensions false --declaration true --outDir dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vue-sfc-i18n/shared": "workspace:*",
    "eslint": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.0"
  }
}
